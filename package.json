{
  "name": "online-exam-system",
  "version": "1.0.0",
  "description": "Full-stack MERN Online Examination System ready for Vercel deployment",
  "main": "api/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node api/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "vercel-build": "npm run build",
    "postinstall": "npm install --prefix client",
    "start": "node api/index.js"
  },
  "keywords": ["mern", "online-exam", "vercel", "react", "express", "mongodb", "nodejs"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
