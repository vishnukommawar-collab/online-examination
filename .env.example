# MongoDB Atlas Connection URI
# Leave blank to run in automatic zero-config In-Memory turnkey fallback mode!
# For production Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/examsphere?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for signing authentication tokens
JWT_SECRET=examsphere_production_secure_secret_key_2025

# Port for local backend API server
PORT=5000

# Node Environment
NODE_ENV=production
